# All settings are optional. No secrets are needed to run Scrum Poker.
# Copy to .env to override defaults locally (./run.sh, npm run dev and npm start load it if
# present; real environment variables win). In Docker/Railway set environment variables instead.

# HTTP port and interface (./run.sh and npm start listen on 0.0.0.0; --local/--dev on 127.0.0.1)
PORT=3000
# HOST=0.0.0.0

# Where games are snapshotted (JSON). Set PERSIST=0 to keep games in memory only.
DATA_DIR=./data
PERSIST=1

# Data retention: games are deleted after this many days without activity.
ROOM_TTL_DAYS=30
# Seconds a disconnected player keeps their seat (and vote) before being removed.
PLAYER_GRACE_SECONDS=60

# Number of reverse proxies / load balancers in front of the app (Railway, nginx: 1).
# Enables X-Forwarded-For (read from the right), -Host and -Proto.
TRUST_PROXY=0
# Origins allowed to open WebSockets in addition to the app's own host, comma-separated.
# ALLOWED_ORIGINS=https://poker.example.com

# Abuse limits
MAX_GAMES=5000
MAX_CONNECTIONS=10000
MAX_CONNECTIONS_PER_IP=200
GAME_CREATES_PER_MINUTE=30

LOG_LEVEL=info
# LOG_FORMAT=json   # default: readable lines in a terminal, JSON otherwise (Docker, Railway)
